simc "0.9.0";

/*
 * liq2sol refund leaf (DRAFT, not audited). The sender's signature, once the transaction's lock height has been reached.
 * Claims don't use this: they are ordinary key-path spends, so this leaf is only ever revealed by a refund.
 */
fn main() {
    jet::check_lock_height(param::LOCK_HEIGHT);
    let msg: u256 = jet::sig_all_hash();
    jet::bip_0340_verify((param::SENDER_PK, msg), witness::SENDER_SIG);
}
